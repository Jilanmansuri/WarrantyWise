{
  "expo": {
    "name": "WarrantyWise",
    "slug": "warrantywise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "warrantywise",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.warrantywise.app"
    },
    "android": {
      "package": "com.warrantywise.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F295C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F295C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WarrantyWise to access your photos to attach product images and invoices.",
          "cameraPermission": "Allow WarrantyWise to use the camera to scan purchase invoices and receipts."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WarrantyWise to use your camera to capture purchase invoices."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A8A"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
